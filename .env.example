# Copy this file to .env and fill in real values before running docker compose up.

# Long random secret used to sign JWTs. Generate one with e.g.:
#   openssl rand -base64 48
JWT_KEY=

# Optional overrides (sensible defaults are used if omitted)
# POSTGRES_PASSWORD=postgres
# ASPNETCORE_ENVIRONMENT=Development

# Origem do frontend (usada pela API para liberar CORS) e da API (embutida no bundle
# do frontend em build-time, via VITE_API_URL). Defaults já apontam pras portas
# publicadas por este compose (8081/8080) — só sobrescreva se mudar as portas.
# FRONTEND_ORIGIN=http://localhost:8081
# API_ORIGIN=http://localhost:8080
#
# Para deploy real (domínios públicos, proxy reverso), ver deploy/docker-compose.yml.
