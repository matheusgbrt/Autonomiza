# Copy this file to .env and fill in real values before running docker compose up.

# Long random secret used to sign JWTs. Generate one with e.g.:
#   openssl rand -base64 48
JWT_KEY=

# Optional overrides (sensible defaults are used if omitted)
# POSTGRES_PASSWORD=postgres
# ASPNETCORE_ENVIRONMENT=Development

# Domínio público do frontend (usado pela API para liberar CORS) e da API (embutido
# no bundle do frontend em build-time, via VITE_API_URL).
# FRONTEND_ORIGIN=https://controleautonomo.gtlabs.com.br
# API_ORIGIN=https://api.controleautonomo.gtlabs.com.br
