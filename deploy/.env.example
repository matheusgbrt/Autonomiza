# Copie para .env (ou preencha como Environment variables direto na stack do
# Portainer) antes de fazer o deploy de deploy/docker-compose.yml.

# Senha do usuário postgres deste stack (banco novo, ainda não existe).
POSTGRES_PASSWORD=

# Segredo longo e aleatório usado para assinar os JWTs. Gere um com:
#   openssl rand -base64 48
JWT_KEY=
